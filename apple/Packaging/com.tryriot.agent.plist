<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The menu bar app, started in every user session (SMAppService.agent(plistName:)). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tryriot.agent</string>
  <key>BundleProgram</key><string>Contents/MacOS/RiotAgent</string>
  <key>AssociatedBundleIdentifiers</key><array><string>com.tryriot.agent</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>LimitLoadToSessionType</key><string>Aqua</string>
  <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
