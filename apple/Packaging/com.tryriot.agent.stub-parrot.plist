<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Test fleets only (WITH_STUB=1 apple/build-app.sh): parrot's agent API, stubbed on loopback
     for the daemon (the profile's ApiUrl is http://127.0.0.1:7592/portal). Registered by
     Riot.app like the daemon, pre-approved by the same Managed Login Items rule. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tryriot.agent.stub-parrot</string>
  <key>BundleProgram</key><string>Contents/MacOS/riot-stub-parrot</string>
  <key>AssociatedBundleIdentifiers</key><array><string>com.tryriot.agent</string></array>
  <key>UserName</key><string>nobody</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
