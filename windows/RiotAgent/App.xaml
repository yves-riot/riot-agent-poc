<!-- The application and what the HUD and the popup share: text styles, the tinted boxes, and the
     templates of the views they show (Views.cs). Colours come from the Fluent theme, light or dark
     as Windows is set. -->
<Application x:Class="Riot.Agent.App.App"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Riot.Agent.App"
             ThemeMode="System"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <local:VisibleWhenSet x:Key="VisibleWhenSet" />

    <SolidColorBrush x:Key="DangerTint" Color="#14E03B3B" />
    <SolidColorBrush x:Key="CautionTint" Color="#18F59E0B" />
    <SolidColorBrush x:Key="NeutralTint" Color="#14808080" />
    <SolidColorBrush x:Key="AvatarTint" Color="#26005FB8" />

    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="StrongText" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource StrongText}">
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="SmallText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- Above a list in the popup. -->
    <Style x:Key="SectionText" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Box" TargetType="Border">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="LinkText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
      <Setter Property="TextDecorations" Value="{x:Null}" />
    </Style>

    <!-- The bot's picture in a circle, over a shield shown until it loads (or where there is none). -->
    <DataTemplate DataType="{x:Type local:HeaderView}">
      <DockPanel>
        <Grid DockPanel.Dock="Left" Width="{Binding Size}" Height="{Binding Size}" VerticalAlignment="Top">
          <Ellipse Fill="{StaticResource AvatarTint}" />
          <Path Margin="{Binding ShieldMargin}" Stretch="Uniform" Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Data="M16,2 L28,6.5 L28,15 C28,22.5 22.8,27.8 16,30 C9.2,27.8 4,22.5 4,15 L4,6.5 Z" />
          <Ellipse>
            <Ellipse.Fill>
              <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill" />
            </Ellipse.Fill>
          </Ellipse>
        </Grid>
        <StackPanel Margin="12,0,0,0">
          <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" />
          <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryText}" Margin="0,2,0,0"
                     Visibility="{Binding Subtitle, Converter={StaticResource VisibleWhenSet}}" />
        </StackPanel>
      </DockPanel>
    </DataTemplate>

    <!-- What was found, as the extension lists it: at most four types, then "and N more". -->
    <DataTemplate DataType="{x:Type local:FindingsView}">
      <Border Style="{StaticResource Box}" Padding="12,9" Background="{StaticResource DangerTint}">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,3" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="●" FontSize="9" Foreground="IndianRed" VerticalAlignment="Center" />
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" Style="{StaticResource BodyText}" Margin="8,0,0,0" />
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource SecondaryText}" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding More}" Style="{StaticResource SmallText}" Margin="0,3"
                     Visibility="{Binding More, Converter={StaticResource VisibleWhenSet}}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:WarningView}">
      <Border Style="{StaticResource Box}" Background="{StaticResource CautionTint}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{StaticResource StrongText}" />
          <TextBlock Text="{Binding Body}" Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Application.Resources>
</Application>
